# Copy to .env and enter keys locally. Never commit .env.
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# X OAuth 2.0: configure a confidential Web App in the X developer console.
# Register this exact callback URL, including the port and 127.0.0.1 hostname.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:2719/auth/x/callback

# Optional: used only by the legacy notebook's public-tweet importer.
X_BEARER_TOKEN=
# Optional local profile built from official X API data; never commit the profile.
X_VOICE_PROFILE=

# Optional model overrides.
STYLE_WRITER_MODEL=gpt-5.6-luna
STYLE_JUDGE_MODEL=jev-1.13.0
